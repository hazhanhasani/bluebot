# Composer-managed dependencies — installed by install.sh at install/update time.
# Never commit these; run `composer install` to recreate them.
/vendor/

# Composer runtime artifacts
composer.phar

# Runtime / generated files
*.log
*.tmp
*.cache
error_log
cronbot/.run.lock
/storage/**
!/storage/cache/
!/storage/.htaccess
!/storage/cache/.htaccess
/api/hash.txt
*.xlsx
graphify-out
/docs/generated/
/lang/override/
/deploy.sh

# Local secrets / environment overrides
.env
.env.*
!.env.example
*.local.php

# Backups / database dumps / temporary archives
*.bak
*.backup
*.dump
*.sql.gz
*.tar
*.tar.gz
*.tgz

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
