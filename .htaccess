<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal application code is never a public HTTP surface.
    RewriteRule ^(?:db|src|tests|scripts|vendor)(?:/|$) - [F,L,NC]

    # Cron jobs are executed by the authenticated dispatcher. Individual jobs
    # must never be triggerable directly from the web.
    RewriteRule ^cronbot/(?!run\.php$).*\.php$ - [F,L,NC]

    RewriteCond %{DOCUMENT_ROOT}/install/index.php -f
    RewriteCond %{REQUEST_URI} !^/install/
    RewriteRule ^ - [F,L]
</IfModule>

<Files "*.txt">
    Require all denied
</Files>
<Files "error_log">
    Require all denied
</Files>
<Files "*.sh">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
    RedirectMatch 404 ^/(?:db|src|tests|scripts|vendor)(?:/|$)
    RedirectMatch 404 ^/cronbot/(?!run\.php$).*\.php$
</IfModule>
<Files "*.json">
    Require all denied
</Files>
<Files "*.sql">
    Require all denied
</Files>
<Files "*.zip">
    Require all denied
</Files>

Options -Indexes

<FilesMatch "^error_log$|\.log$|\.log\.[0-9]+$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>


# BlueBot sensitive project metadata must never be served directly.
<FilesMatch "^(config\.php|composer\.(json|lock)|\.env(?:\..*)?|\.gitignore)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
