<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/install/index.php -f
    RewriteRule ^ - [F,L]
</IfModule>

<Files "utils.php">
    Require all denied
</Files>

RewriteEngine On


RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

RewriteCond %{REQUEST_FILENAME}.php -f

RewriteRule ^([^/]+)$ $1.php [L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]

RewriteRule ^ /%1 [R=301,L]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

Options -Indexes

<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header always set Cache-Control "private, no-store, no-cache, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set CDN-Cache-Control "no-store"
        Header always set Cloudflare-CDN-Cache-Control "no-store"
        Header always merge Vary "Authorization"
    </FilesMatch>
</IfModule>


<FilesMatch "^error_log$|\.log$|\.log\.[0-9]+$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
